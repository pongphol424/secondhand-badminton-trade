<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dropdown Test</title>
  <link rel="stylesheet" href="/semantic/semantic.min.css">
  <script src="https://code.jquery.com/jquery-3.1.1.min.js"
    integrity="sha256-hVVnYaiADRTO2PzUGmuLJr8BLUSjGIZsDYGmIJLv2b8="
    crossorigin="anonymous"></script>
  <script src="/semantic/semantic.min.js"></script>
</head>
<div class="ui tiny top fixed menu transition visible">
    <div class="ui huge red pointing menu">
        <a href="{{route('market.home')}}" class="active item">Home</a>
        <div class="right item">
            <div class="ui dropdown item">
                For seller <i class="dropdown icon"></i>
                <div class="menu">
                    <div><a href="{{route('user.login')}}" class="active item selected">Login</a></div>
                    <div><a href="{{route('user.register')}}"class="active item selected">SignUp</a></div>
                </div>
            </div>

        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
      $('.ui.dropdown').dropdown();
    });
  </script>

</body>
</html>