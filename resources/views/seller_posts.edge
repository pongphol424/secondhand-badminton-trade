@layouts.master()
@slot('navbar')
@include('partials/navbarIsAuth')
@end
<br><br><br><br>
@if(!posts)
    <div class="ui segment" style="height: 170px">
    <div class="content">
        <div>
            <div class="ui header">Badminton Trade Welcome</div>
            <div class="left floated">Please Create your post</div>
            <br>
            <a href="{{route('seller.create')}}"class=" ui huge teal button"> Create </a>
        </div>
    </div>
</div>
@else
<h1>Your Posts</h1>
@each(post in posts)
<div class="ui segment" style="height: 170px">
    <div class="content">
        <img class="left floated ui image" height="150px" width="120px" src={{asset(post.images[0].filePath)}}>
        <div>
            
            <div class="ui header">Title: {{post.title}}</div>
            <div class="left floated">Description: {{ post.body }}</div>
            <div class="left floated">Price: {{ post.price }}</div>
        </div>
        <br>
        <a href="{{route('market.show',[post.id])}}"class=" ui tiny orange button">Buyer view</a>
        <a href="{{route('seller.edit',[post.id])}}"class=" ui tiny teal button">Edit</a>
        <a href="{{route('seller.delete',[post.id])}}"class=" ui tiny red button">Delete</a>
    </div>
</div>
@end
@end
@end